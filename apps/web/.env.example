# Copy to .env.local (never commit real values). Read on the server only: nothing here is exposed to the browser.

# PostgreSQL connection string. Run `pnpm --filter web db:migrate` against it before first use.
DATABASE_URL=postgres://crm_app:change-me@localhost:5432/kentracks_erp

# Optional. Set to 1 ONLY on a machine whose DATABASE_URL is local, to let package sales verify IMEIs
# with the built-in MOCK GPS platform. Without it IMEI verification fails closed (no sale can be recorded).
# Never set it in production.
# GPS_MOCK=1

# Optional. Set to 1 ONLY when the app runs behind a reverse proxy that sets the real client address
# (cf-connecting-ip / x-forwarded-for), e.g. Cloudflare or Traefik. It enables the per-address sign-in limit.
# If the app is directly reachable, leave it unset: those headers can be forged.
# AUTH_TRUST_PROXY=1

# There are no sign-in secrets to configure: sessions are random tokens stored (as hashes) in the database,
# and passwords are salted scrypt hashes. Users are created by an administrator:
#   pnpm --filter web auth:user create --email you@company.com --name "Your Name" --tenant-id <uuid>
# (create a company row for local development with: pnpm --filter web db:dev-tenant "Company name")

# GPSPlatform API: nothing to set here. Each company enters its GPSPlatform account and password in
# Settings -> GPS Platform. (GPS_API_URL can override http://api.kentracksgps.com, for tests only.)
