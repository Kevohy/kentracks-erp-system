# Copy to .env.local (never commit real values). Read on the server only: nothing here is exposed to the browser.

# PostgreSQL connection string. Run `pnpm --filter web db:migrate` against it before first use.
DATABASE_URL=postgres://crm_app:change-me@localhost:5432/kentracks_erp

# Optional. Set to 1 ONLY on a machine whose DATABASE_URL is local, to let package sales verify IMEIs
# with the built-in MOCK GPS platform. Without it IMEI verification fails closed (no sale can be recorded).
# Never set it in production.
# GPS_MOCK=1

# Recommended in production. Tells the app which proxy sets the real client address, which enables the per-address
# sign-in limits (and stops someone elsewhere from locking a user out). Leave it unset if the app is directly
# reachable from the internet: those headers can then be forged.
#   AUTH_TRUST_PROXY=cloudflare   behind Cloudflare (uses cf-connecting-ip)
#   AUTH_TRUST_PROXY=1            behind one other proxy such as Traefik (uses the last x-forwarded-for entry)
# AUTH_TRUST_PROXY=cloudflare

# There are no sign-in secrets to configure: sessions are random tokens stored (as hashes) in the database,
# and passwords are salted scrypt hashes. Users are created by an administrator:
#   pnpm --filter web auth:user create --email you@company.com --name "Your Name" --tenant-id <uuid>
# (create a company row for local development with: pnpm --filter web db:dev-tenant "Company name")

# GPS platforms: each company enters its account and password in Settings -> GPS Platforms. The ERP stores them
# ENCRYPTED with this key (required to add or change an account). 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it casually: saved GPS logins can only be read with the same key.
GPS_CREDENTIALS_KEY=
# GPS platforms are reached over https. Only if a provider has no https, set this to 1 to allow plain http for it.
# GPS_ALLOW_HTTP=1
# (GPS_API_URL can override the platform address, for tests only.)
# Background GPS refresh: device status every minute, dates every 10 minutes. Set to off on a server that must not run it.
# GPS_AUTO_SYNC=off
# How often the live device status is asked for, in ms (default 60000). Raise it if the GPS platform asks you to.
# GPS_STATUS_EVERY_MS=60000

# API rate limit (token bucket per signed-in user): a bucket of RATE_LIMIT_CAPACITY requests that refills at
# RATE_LIMIT_PER_SECOND. Defaults: 60 and 1. Settings → Server Monitoring shows how many requests it holds back.
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_PER_SECOND=1

# Africa's Talking (Communication → Airtime). Both are needed to send airtime; the key never reaches the browser.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# TextSMS (Communication → Bulk SMS, and every SMS the system sends). All three are needed; never sent to the browser.
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SENDER_ID=
# Set to off on a server that must not send the automatic monthly airtime reminders (e.g. a second copy of the app).
# SMS_AUTO_REMINDERS=off
